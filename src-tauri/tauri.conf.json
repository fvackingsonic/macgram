{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacTele",
  "version": "0.1.0",
  "identifier": "com.mactele.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MacTele",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/tdlib/files/**",
          "$APPLOCALDATA/tdlib/db/profile_photos/**",
          "$APPLOCALDATA/tdlib/db/thumbnails/**",
          "$APPLOCALDATA/tdlib/db/secret_thumbnails/**",
          "$APPLOCALDATA/tdlib/db/wallpapers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "lib/*"
    ],
    "shortDescription": "Неофициальный клиент Telegram в стиле macOS",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
